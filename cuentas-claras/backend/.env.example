# Flask Configuration
SECRET_KEY=cuentas-claras-secret-key-change-in-prod
FLASK_ENV=development
FLASK_APP=run.py

# Database Configuration
# Para SQLite local: sqlite:///cuentas_claras.db
# Para PostgreSQL (Neon/Supabase/etc): postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///cuentas_claras.db

# Security & JWT
JWT_EXPIRY_HOURS=24
ALLOW_PUBLIC_REGISTRATION=false

# Google Auth Integration
GOOGLE_CLIENT_ID=119330743944-mufo1sbkqmt8906jrsbd0hhkbdffrcvo.apps.googleusercontent.com

# Firebase Cloud Messaging (Push Notifications - Fase 2)
# Opción 1: Contenido del archivo JSON de cuenta de servicio como string
FIREBASE_CREDENTIALS=
# Opción 2: Ruta al archivo JSON de cuenta de servicio de Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=

