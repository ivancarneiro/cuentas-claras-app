# Flask Configuration
SECRET_KEY=cuentas-claras-secret-key-change-in-prod
FLASK_ENV=development
FLASK_APP=run.py

# Database Configuration
# Para SQLite local: sqlite:///cuentas_claras.db
# Para PostgreSQL (Neon/Supabase/etc): postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///cuentas_claras.db

# Security & JWT
JWT_EXPIRY_HOURS=24
ALLOW_PUBLIC_REGISTRATION=false
APP_OWNER_EMAILS=admin@cuentasclaras.app

# Google Auth Integration
GOOGLE_CLIENT_ID=tu_google_client_id_web.apps.googleusercontent.com

# GitHub Releases (In-App Updates)
# GITHUB_TOKEN=ghp_xxxx (opcional para repos privados o rate-limiting)
GITHUB_REPO=ivancarneiro/cuentas-claras-app
LATEST_APP_VERSION=1.0.5
